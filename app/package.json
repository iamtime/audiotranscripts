{
  "name": "ushi",
  "productName": "ushi",
  "version": "1.4.0",
  "description": "Local real-time speech-to-text with screenshots",
  "main": "main.js",
  "private": true,
  "author": "Rauf Aliev",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac dmg --arm64",
    "dist:win": "electron-builder --win nsis --x64"
  },
  "build": {
    "appId": "com.raufaliev.voicerec",
    "productName": "ushi",
    "copyright": "Rauf Aliev",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "splash.html",
      "splash-logo.jpg",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../build/stage/voice-rec",
        "to": "voice-rec"
      },
      {
        "from": "../build/app-python",
        "to": "python"
      },
      {
        "from": "../build/models",
        "to": "models"
      }
    ],
    "asar": true,
    "afterPack": "build/after-pack.js",
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "minimumSystemVersion": "14.0",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "ushi transcribes your speech locally, on this Mac.",
        "NSScreenCaptureUsageDescription": "ushi takes screenshots of what you are talking about.",
        "NSAudioCaptureUsageDescription": "ushi transcribes the audio of the app you choose (e.g. a call), locally on this Mac.",
        "NSAppleEventsUsageDescription": "ushi copies the selected text when you press the capture hotkey.",
        "LSApplicationCategoryType": "public.app-category.productivity"
      }
    },
    "dmg": {
      "format": "ULFO",
      "title": "ushi",
      "contents": [
        {
          "x": 140,
          "y": 190
        },
        {
          "x": 400,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3"
  }
}
